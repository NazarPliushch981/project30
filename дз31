
#include <iostream>
#include <cstring>

class String {
private:
    char* data;   //зберіг строки
    size_t size;  // довжина строки

public:
    // Конструктор без параметрів
    String() : data(nullptr), size(0) {
        std::cout << "Створена порожня строка\n";
    }

    // Конструктор C-рядка
    String(const char* str) {
        std::cout << "Створення строки з C-рядка\n";
        size = strlen(str);
        data = new char[size + 1];
        strcpy(data, str);
    }

    // Конструктор копіювання
    String(const String& other) {
        std::cout << "Копіювання строки\n";
        size = other.size;
        data = new char[size + 1];
        strcpy(data, other.data);
    }

    // Конструктор переміщення
    String(String&& other) noexcept {
        std::cout << "Переміщення строки\n";
        data = other.data;
        size = other.size;
        //об’єкт обнуляеться
        other.data = nullptr;
        other.size = 0;
    }

    // Оператор присвоєння
    String& operator=(const String& other) {
        std::cout << "Присвоєння копіюванням\n";
        if (this == &other) return *this;
        delete[] data; // старі дані видаляються
        size = other.size;
        data = new char[size + 1];
        strcpy(data, other.data);
        return *this;
    }

    // Оператор присвоєння з переміщенням
    String& operator=(String&& other) noexcept {
        std::cout << "Присвоєння переміщенням\n";
        if (this == &other) return *this; // перевірка на самоприсвоєння
        delete[] data; 
        data = other.data;
        size = other.size;
        other.data = nullptr;
        other.size = 0;
        return *this;
    }

    // Деструктор
    ~String() {
        std::cout << "Видалення строки\n";
        delete[] data;
    }

    //  функція для виводу
    void print() const {
        if (data)
            std::cout << data << std::endl;
        else
            std::cout << "(порожня)" << std::endl;
    }
};

// Демонстрація роботи
int main() {
    String s1("Привіт");
    String s2 = s1;   // копіювання
    String s3 = std::move(s1); // переміщення

    s2.print();
    s3.print();
    s1.print(); 

    String s4;
    s4 = s2;          // присвоєння копіюванням
    String s5;
    s5 = std::move(s2); // присвоєння переміщенням

    s4.print();
    s5.print();

    return 0;
}

